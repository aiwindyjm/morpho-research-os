{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morpho.dev/schemas/research-config.v1.json",
  "title": "ResearchConfig",
  "description": "Structured research configuration for one project (PRD section 5). Persisted record form: adds config_id and project_id to the user-editable fields.",
  "type": "object",
  "required": [
    "schema_version",
    "config_id",
    "project_id",
    "domain",
    "topic",
    "purpose",
    "depth",
    "dimensions",
    "languages",
    "source_types"
  ],
  "properties": {
    "schema_version": { "enum": ["1.0"] },
    "config_id": { "type": "string", "description": "UUIDv7 assigned by the Rust Core." },
    "project_id": { "type": "string" },
    "domain": { "type": "string", "minLength": 1 },
    "topic": { "type": "string", "minLength": 1 },
    "purpose": {
      "enum": ["learning", "teaching", "writing", "research", "industry", "product", "strategy", "custom"]
    },
    "audience": { "type": "string" },
    "depth": { "type": "integer", "minimum": 1, "maximum": 5 },
    "dimensions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "time_range": {
      "type": "object",
      "description": "Optional inclusive bounds; RFC 3339 dates or timestamps. Absent means unbounded.",
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" }
      },
      "additionalProperties": false
    },
    "geographic_scope": { "type": "string" },
    "languages": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
    "source_types": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "source_domains": { "type": "array", "items": { "type": "string" } },
    "update_frequency": {
      "type": "string",
      "description": "V0.1 only supports 'manual'; the field stays open for future approved scheduling values."
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
